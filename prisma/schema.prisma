// NextAuth + Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime        @default(now())
  accounts       Account[]
  sessions       Session[]
  transactions   Transaction[]
  categories     Category[]
  paymentMethods PaymentMethod[]
}

model Category {
  id           String          @id @default(cuid())
  userId       String
  name         String
  type         TransactionType
  createdAt    DateTime        @default(now())

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model PaymentMethod {
  id           String            @id @default(cuid())
  userId       String
  name         String
  type         PaymentMethodType
  createdAt    DateTime          @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  type            TransactionType
  amount          Int
  categoryId      String?
  paymentMethodId String?
  counterpart     String?
  description     String?
  date            DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethodType {
  ASSET
  CARD
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LossAlert {
  id        String   @id @default(cuid())
  date      String
  code      String
  name      String
  lossRate  Float
  price     Int
  threshold Float
  alertedAt DateTime @default(now())

  @@unique([date, code])
  @@index([date])
}

model BuyCondition {
  id         String      @id @default(cuid())
  label      String
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  buyRecords BuyRecord[]
}

model BuyRecord {
  id          String        @id @default(cuid())
  code        String
  name        String        @default("")
  qty         Int
  price       Int
  orderType   String
  conditionId String?
  condition   BuyCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  orderedAt   DateTime      @default(now())

  @@index([code])
  @@index([orderedAt])
}

model RsiResult {
  id           String   @id @default(cuid())
  date         String
  mode         String
  code         String
  name         String
  rsi          Float
  signal       Float
  price        Int
  volume       Int
  special      String
  ma5Break     String
  specCol      String
  specColLabel String   @default("")
  createdAt    DateTime @default(now())

  @@unique([date, mode, code])
  @@index([date, mode])
}

model AutoSellCheck {
  id             String   @id @default(cuid())
  checkTime      DateTime
  stockCode      String
  stockName      String
  holdQty        Int
  avgPrice       Float
  currentPrice   Float
  evalAmount     Float
  evalPflsAmount Float
  evalPflsRate   Float
  sellTriggered  Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([checkTime])
  @@index([stockCode])
}

model AutoSellOrder {
  id          String   @id @default(cuid())
  orderTime   DateTime
  stockCode   String
  stockName   String
  orderQty    Int
  triggerRate Float
  orderNo     String?
  resultCode  String?
  resultMsg   String?
  createdAt   DateTime @default(now())

  @@index([orderTime])
  @@index([stockCode])
}

model AutoBuyOrder {
  id          String   @id @default(cuid())
  orderTime   DateTime
  stockCode   String
  stockName   String
  orderQty    Int
  refPrice    Float
  rsiValue    Float
  signalValue Float
  orderNo     String?
  resultCode  String?
  resultMsg   String?
  createdAt   DateTime @default(now())

  @@index([orderTime])
  @@index([stockCode])
}

model RsiTarget {
  id        String   @id @default(cuid())
  stockCode String   @unique
  stockName String   @default("")
  createdAt DateTime @default(now())

  @@index([stockCode])
}
